<mxfile host="app.diagrams.net" agent="carte.js (1re SI S3)" version="24.0.0"><diagram id="el" name="Élève (à trous)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="elc" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;S3 — ÉNERGIE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;puissance · rendement&lt;br&gt;transmission · stockage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4F8C;strokeColor=#133B6B;strokeWidth=3;fontColor=#FFFFFF;fontSize=17;fontFamily=Arial;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="360" height="180" as="geometry"/></mxCell><mxCell id="elb1" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;1  Chaîne de puissance&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Alimenter → &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt; → &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt;&lt;br&gt;→ Transmettre → Agir (effecteur)&lt;br&gt;Lien de puissance : une demi-flèche porte&lt;br&gt;&lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; (au-dessus) et &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; (au-dessous)&lt;br&gt;Batterie : énergie &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; stockée" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="505" height="258" as="geometry"/></mxCell><mxCell id="eleb1" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elb2" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;2  Effort × flux : P = e × f (en W)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Électrique : P = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; × &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (V · A)&lt;br&gt;Translation : P = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; × &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (N · m/s)&lt;br&gt;Rotation : P = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; × &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (N·m · rad/s)&lt;br&gt;Hydraulique : P = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; × &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (Pa · m³/s)&lt;br&gt;Thermique : P = T × Ṡ   (K · W/K)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="547" y="20" width="505" height="258" as="geometry"/></mxCell><mxCell id="eleb2" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elb3" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;3  Rendement et pertes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;η = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (sans unité, η &amp;lt; 1)&lt;br&gt;Chaîne : η&lt;sub&gt;g&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;………………………&lt;/font&gt;&lt;br&gt;Pertes : P&lt;sub&gt;pertes&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;&lt;br&gt;Effet Joule : P&lt;sub&gt;J&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;&lt;br&gt;Remonter la chaîne : P&lt;sub&gt;amont&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1075" y="20" width="505" height="258" as="geometry"/></mxCell><mxCell id="eleb3" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elb6" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;6  Moteur à courant continu&lt;/font&gt;&lt;/b&gt;&lt;br&gt;U = &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt;   (E : f.c.é.m.)&lt;br&gt;C = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   et   E = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;&lt;br&gt;Caractéristique : pour un couple C, on lit&lt;br&gt;N, P&lt;sub&gt;élec&lt;/sub&gt;, P&lt;sub&gt;méca&lt;/sub&gt; et η (point de fonctionnement)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="767" width="505" height="218" as="geometry"/></mxCell><mxCell id="eleb6" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elb5" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;5  Énergie et batterie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;E = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (W·h ; 1 W·h = 3 600 J)&lt;br&gt;Batterie : E = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;   (Q en A·h)&lt;br&gt;Autonomie : t = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;&lt;br&gt;En série, les &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt; s’additionnent&lt;br&gt;En parallèle, les &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt; s’additionnent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="547" y="727" width="505" height="258" as="geometry"/></mxCell><mxCell id="eleb5" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elb4" value="&lt;b&gt;&lt;font color=&quot;#133B6B&quot; style=&quot;font-size:18px&quot;&gt;4  Transmettre : vitesses et couples&lt;/font&gt;&lt;/b&gt;&lt;br&gt;r = ω&lt;sub&gt;s&lt;/sub&gt; / ω&lt;sub&gt;e&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;……………………………………&lt;/font&gt;&lt;br&gt;r &amp;lt; 1 : &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt; ;  r &amp;gt; 1 : &lt;font color=&quot;#56677A&quot;&gt;………………………&lt;/font&gt;&lt;br&gt;ω (rad/s) = &lt;font color=&quot;#56677A&quot;&gt;…………………&lt;/font&gt;   (N en tr/min)&lt;br&gt;Couple de sortie : C&lt;sub&gt;s&lt;/sub&gt; = &lt;font color=&quot;#56677A&quot;&gt;………………&lt;/font&gt;&lt;br&gt;Rotation → translation : V = &lt;font color=&quot;#56677A&quot;&gt;……………&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#EEF3F9;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1075" y="727" width="505" height="258" as="geometry"/></mxCell><mxCell id="eleb4" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;" edge="1" parent="1" source="elc" target="elb4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elm1" value="&lt;b&gt;&lt;font color=&quot;#56677A&quot; style=&quot;font-size:18px&quot;&gt;✎  Méthode de rédaction&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Relation littérale&lt;br&gt;2. Application numérique (unités SI)&lt;br&gt;3. Résultat + unité, arrondi raisonnable&lt;br&gt;Contrôle : η &amp;lt; 1 ; P&lt;sub&gt;sortie&lt;/sub&gt; &amp;lt; P&lt;sub&gt;entrée&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="391" width="505" height="218" as="geometry"/></mxCell><mxCell id="elem1" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;dashed=1;" edge="1" parent="1" source="elc" target="elm1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="elm2" value="&lt;b&gt;&lt;font color=&quot;#56677A&quot; style=&quot;font-size:18px&quot;&gt;★  Systèmes étudiés en S3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Perceuse, servomoteur, pompage solaire,&lt;br&gt;bras de robot, ROVIO, portail SET,&lt;br&gt;éolienne (r = 45,45 : &lt;font color=&quot;#56677A&quot;&gt;………………………&lt;/font&gt;),&lt;br&gt;navire, tondeuse, pilote de bateau" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1B4F8C;strokeWidth=2;fontColor=#13263F;fontSize=16;fontFamily=Arial;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1075" y="391" width="505" height="218" as="geometry"/></mxCell><mxCell id="elem2" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=none;strokeColor=#1B4F8C;strokeWidth=3;dashed=1;" edge="1" parent="1" source="elc" target="elm2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>